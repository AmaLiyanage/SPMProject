{
  "expo": {
    "name": "HerPower",
    "slug": "HerPower",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/herPowerLogo2.png",
    "scheme": "herpower",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
        "supportsTablet": true,
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert your voice to text.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record your voice."
      },
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/images/herPowerLogo2.png",
      "roundIcon": "./assets/images/herPowerLogo2.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/herPowerLogo2.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.HerPower"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "hideAppNameInSplash": true
        }
      ],
      "expo-font",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75c98a5b-29e6-49d3-aa53-16941ae583e4"
      }
    }
  }
}
